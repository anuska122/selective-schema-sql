# Generate local database passwords as shown in README.md.
POSTGRES_ADMIN_PASSWORD=
SQLAGENT_RO_PASSWORD=
# Required for model requests; never commit a real key.
GROQ_API_KEY=
# Set a strong shared token before exposing the API.
SQLAGENT_API_TOKEN=
SQLAGENT_DAILY_QUESTIONS=100
SQLAGENT_HOURLY_QUESTIONS=5
SQLAGENT_PAUSED=0
# Optional locally; the Docker image sets its own persistent-volume path.
SQLAGENT_LIMIT_DB=data/limits.sqlite3
